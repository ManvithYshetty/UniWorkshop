---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
            <fieldset>
              <legend class="mb-4 text-lg font-medium text-slate-100">Filter games</legend>

              <div class="grid gap-6 md:grid-cols-2">
                <div>
                  <p class="mb-3 text-sm font-medium text-slate-200">Categories</p>
                  <div class="grid gap-2 sm:grid-cols-2">
                    {categories.map((category) => (
                      <label class="flex items-center gap-2 text-sm text-slate-300">
                        <input
                          type="checkbox"
                          value={category.id}
                          data-testid={`category-filter-${category.id}`}
                          data-filter-category
                          class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                        />
                        <span>{category.name}</span>
                      </label>
                    ))}
                  </div>
                </div>

                <div>
                  <label for="publisher-filter" class="mb-3 block text-sm font-medium text-slate-200">
                    Publisher
                  </label>
                  <select
                    id="publisher-filter"
                    data-testid="publisher-filter"
                    class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  >
                    <option value="">All publishers</option>
                    {publishers.map((publisher) => (
                      <option value={publisher.id}>{publisher.name}</option>
                    ))}
                  </select>
                </div>
              </div>

              <div class="mt-6 flex flex-wrap items-center gap-4">
                <p class="text-sm text-slate-300" data-testid="filter-result-count" role="status" aria-live="polite">
                  Showing {games.length} games
                </p>
                <button
                  type="reset"
                  data-testid="clear-filters"
                  class="rounded-lg border border-slate-600 px-4 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                >
                  Clear filters
                </button>
              </div>
            </fieldset>
          </form>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="filtered-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector('[data-testid="game-filters"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const categoryFilters = Array.from(document.querySelectorAll<HTMLInputElement>('[data-filter-category]'));
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');

  if (filterForm && resultCount && emptyState && publisherFilter) {
    const updateResults = (): void => {
      const selectedCategories = categoryFilters
        .filter((filter) => filter.checked)
        .map((filter) => filter.value);
      const selectedPublisher = publisherFilter.value;
      let visibleCount = 0;

      for (const card of gameCards) {
        const categoryMatches =
          selectedCategories.length === 0 ||
          selectedCategories.includes(card.dataset.gameCategoryId ?? '');
        const publisherMatches =
          selectedPublisher === '' || card.dataset.gamePublisherId === selectedPublisher;
        const isVisible = categoryMatches && publisherMatches;

        card.classList.toggle('hidden', !isVisible);
        card.setAttribute('aria-hidden', String(!isVisible));
        if (isVisible) visibleCount += 1;
      }

      resultCount.textContent = `Showing ${visibleCount} games`;
      emptyState.classList.toggle('hidden', visibleCount > 0);
    };

    filterForm.addEventListener('change', updateResults);
    filterForm.addEventListener('reset', () => {
      requestAnimationFrame(updateResults);
    });
  }
</script>
